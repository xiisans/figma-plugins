{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@figma/plugin-typings", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "build.mjs"]
}
