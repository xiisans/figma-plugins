{
  "name": "xiwu-text-operations",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run build:plugin && npm run build:ui",
    "build:plugin": "esbuild src/plugin/main.ts --bundle --outfile=dist/code.js --target=es2020",
    "build:ui": "vite build",
    "dev": "concurrently \"npm:dev:plugin\" \"npm:dev:ui\"",
    "dev:plugin": "esbuild src/plugin/main.ts --bundle --outfile=dist/code.js --target=es2020 --watch",
    "dev:ui": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "visual-check": "node scripts/visual-check.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.117.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.12",
    "jsdom": "^27.2.0",
    "playwright-core": "^1.64.1",
    "sass": "^1.94.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.0.7"
  }
}
